# =============================================================================
# CyberGym 跑批配置 —— Docker Compose 部署
# =============================================================================
# 用法：
#   cp deploy/cybergym/.env.compose.example deploy/cybergym/.env
#   chmod 600 deploy/cybergym/.env
#   $EDITOR deploy/cybergym/.env
#
# Compose 用它做 ${...} 插值和容器环境变量。
# 镜像内路径（WORKSPACE_ROOT / AGENT_ROOT / QITOS_ROOT / PYTHON_BIN）
# 由 compose.yaml 固定为镜像路径，不需要在这里设置。
# 所有密钥只放在这里，不要提交到 git。
# =============================================================================


# -----------------------------------------------------------------------------
# 一、宿主机路径
# -----------------------------------------------------------------------------

# CyberGym 源码根目录，必须包含 src/cybergym/task/README.template。
# 会以相同路径挂进容器；跑批从这里导入 cybergym 包。
CYBERGYM_ROOT=/opt/cybergym

# CyberGym 任务语料目录，跑批从这里读取任务数据。
# 会以只读方式挂进容器，必须是宿主机绝对路径。
DATA_DIR=/opt/cybergym/cybergym_data/data

# 预编译漏洞二进制根目录，布局为 <series>/<id>/vul/out/。
# 会以只读方式挂进容器，也是每任务容器 -v 挂载的来源。
BINARY_DIR=/opt/cybergym-bin/cybergym-server-data


# -----------------------------------------------------------------------------
# 二、跑批组
# -----------------------------------------------------------------------------

# 本组的运行根目录。轨迹、workspace、结果文件都写在这里。
# 必须同时是宿主机和容器内的同一个绝对路径；建议放本地 ext4/xfs。
RUN_ROOT=/opt/qitos-bench/runs/level1-a

# 任务清单文件，每行一个任务 ID，例如 arvo:3938、oss-fuzz:42535201。
# 文件必须存在且非空；空行会被忽略。
TASK_FILE=/opt/qitos-bench/runs/level1-a/tasks.txt

# 组名，用于默认日志和输出命名；多组部署时保持唯一。
GROUP_NAME=level1-a

# 轨迹文件名前缀，建议带 agent 版本，便于之后筛选。
TRACE_PREFIX=qitos_level1-a_glm-51

# 跑批结果 JSONL 文件。--resume 会读取它来跳过已完成任务。
# 必须是宿主机绝对路径，并且位于 RUN_ROOT 下（会被挂载进容器）。
OUTPUT_JSONL=/opt/qitos-bench/runs/level1-a/results.jsonl

# 每任务简报 JSONL（可选）。每完成一个任务追加一行，只含
# task_id / success / stop_reason / final_result / elapsed_seconds；
# 失败时带 reason，服务端有判定时带 vul_exit_code / fix_exit_code。
REPORT_JSONL=/opt/qitos-bench/runs/level1-a/results.report.jsonl


# -----------------------------------------------------------------------------
# 三、验证服务
# -----------------------------------------------------------------------------

# 验证服务地址。Compose 只使用这一项。
#   - 同机：http://host.docker.internal:6441
#     （compose 已加 host-gateway 映射；server 必须监听 0.0.0.0）
#   - 异机：http://<server-ip>:6441
# 注意：不要写 127.0.0.1，容器里的 127.0.0.1 指的是容器自己。
SERVER_URL=http://host.docker.internal:6441


# -----------------------------------------------------------------------------
# 四、模型端点
# -----------------------------------------------------------------------------

# OpenAI 兼容接口的 Base URL。
# 必须以 /v1 结尾，客户端不会自动补；少了会报 404。
BASE_URL=https://your-endpoint.example.com/v1

# 模型名称，会原样传给模型端点。
# 例如 GLM-5.1、deepseek-v4.1-flash、mimo-v2.6-flash。
# 网关别名按模型家族匹配：ap-ds-v4-flash 会命中 deepseek-v4 家族，套用该家族的
# 64k 输出预算和 30 分钟超时，而不是 8k/360s。
MODEL_NAME=GLM-5.1

# 模型 API key。只用于调用模型，不能和 CYBERGYM_GRADING_KEY 混用。
# 如果 key 里含 $、# 或空格，请用单引号包起来。
LLM_API_KEY=replace-with-model-key

# --- 可选：模型请求覆盖 ---
# 留空表示按模型家族默认值：推理家族 65536 输出 token / 1800s 超时，
# 其他模型 8192 / 360s；上下文窗口按模型名推断。
# 单次请求最大输出 token。
# CYBERGYM_MAX_OUTPUT_TOKENS=
# 单次请求超时（秒）。
# CYBERGYM_LLM_TIMEOUT_SECONDS=
# 上下文窗口（token 数）。
# CYBERGYM_CONTEXT_WINDOW=
# 推理强度：none / minimal / low / medium / high / xhigh / max（留空用端点默认）。
# CYBERGYM_REASONING_EFFORT=


# -----------------------------------------------------------------------------
# 五、打分
# -----------------------------------------------------------------------------

# 验证服务的提交认证 key，必须与 server 端的 CYBERGYM_API_KEY 完全一致。
# 绝不能复用 LLM_API_KEY；两者写反会表现为“认证失败”。
CYBERGYM_GRADING_KEY=replace-with-grading-key


# -----------------------------------------------------------------------------
# 六、调度与预算
# -----------------------------------------------------------------------------

# 并发任务数。真正的瓶颈是内存，不是 CPU：
# 8 GB 建议 1，16 GB 建议 2，32 GB 以上可到 2-4。
CONCURRENCY=2

# 引擎内部步数上限，仅作为防死循环的 guardrail。
# 实际停止主要由 MAX_RUNTIME_SECONDS 控制，通常不需要修改。
MAX_STEPS=1000000

# 单任务墙钟预算，单位秒。14400 = 4 小时；超时会以 budget_time 停止。
MAX_RUNTIME_SECONDS=14400

# 断点续跑（可选，默认关闭）。CHECKPOINT_DIR 为每个任务持久化一个 checkpoint 文件；
# CONTINUE_FROM_CHECKPOINT=1 时，撞墙钟/被硬杀的任务从最后完成的步骤继续。
# 不设置时行为不变：任务被杀后从第 0 步重跑。
# CHECKPOINT_DIR=/opt/qitos-bench/runs/level1-a/checkpoints
CONTINUE_FROM_CHECKPOINT=0

# 超时重跑（默认开启）。启动器固定带 --resume，上一轮停在 budget_time /
# interrupt 的任务会重新排队；每个任务最多 MAX_ATTEMPTS 次尝试。设为 0 恢复
# “已有结果一律跳过”的旧行为。
RETRY_TIMEOUT=1
MAX_ATTEMPTS=3

# 运行时异常日志（可选，默认关闭）。模型调用等运行时异常发生时，引擎会把完整
# traceback 追加到日志文件。这三个变量是同一个日志文件的三个路径取值，按优先级
# 只生效一个：QITOS_ERROR_LOG（直接给文件路径）> QITOS_TRACE_DIR（目录，写
# <目录>/step_error.log）> CYBERGYM_TASK_TRACE_DIR（同上，CyberGym 专用）。
# 路径必须落在容器可见的挂载目录内（RUN_ROOT / CYBERGYM_ROOT / DATA_DIR /
# BINARY_DIR），其中只有 RUN_ROOT 是可写的。
# 注意：批跑是单进程并发所有任务，日志按进程汇总，不会按任务分文件；按任务查看
# 错误请读 traces/<run>/events.jsonl 与 manifest.json。
# QITOS_ERROR_LOG=/opt/qitos-bench/runs/level1-a/step_error.log
# QITOS_TRACE_DIR=/opt/qitos-bench/runs/level1-a/error_logs
# CYBERGYM_TASK_TRACE_DIR=/opt/qitos-bench/runs/level1-a/error_logs

# CyberGym 难度级别：level0 / level1 / level2 / level3。
# 当前 agent 主要面向 level1。
DIFFICULTY=level1


# -----------------------------------------------------------------------------
# 七、任务容器
# -----------------------------------------------------------------------------

# 跑批控制容器镜像的版本标签。必须写明确的版本号（如 1.0.12），不要用 local，
# 否则无法分辨实际跑的是哪个镜像。compose.yaml 用它拼出 qitos-cybergym-runner:<tag>。
RUNNER_IMAGE_TAG=1.0.12

# 每个任务使用的 agent 容器镜像。宿主机上必须已经存在该镜像。
DOCKER_IMAGE=cage/claude-code:cyberdebug

# 任务容器的网络模式。
# host = 与宿主机共享网络（默认，动态分析和抓包场景常用）；
# 也可以填 bridge 或自定义网络名。
DOCKER_NETWORK=host


# -----------------------------------------------------------------------------
# 八、可选
# -----------------------------------------------------------------------------

# 当验证服务用 --mask_map_path 启动时，跑批必须使用同一份掩码表，
# 否则每次 submit_poc 都会失败并返回 Invalid task_id。
# 别名 CYBERGYM_MASK_MAP_PATH 也可用。
# CYBERGYM_MASK_MAP=/opt/cybergym/mask_map.json
