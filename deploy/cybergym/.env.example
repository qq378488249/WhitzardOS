# =============================================================================
# CyberGym 跑批配置
# =============================================================================
# 用法：
#   cp deploy/cybergym/.env.example deploy/cybergym/.env
#   chmod 600 deploy/cybergym/.env
#   $EDITOR deploy/cybergym/.env
#
# 这个文件同时被 Docker Compose 用于 ${...} 插值和容器环境变量。
# 所有密钥只放在这里，不要提交到 git。
#
# 重要：RUN_ROOT / CYBERGYM_ROOT / DATA_DIR / BINARY_DIR 会以“相同绝对路径”挂进容器，
# 因此必须填写宿主机上的真实绝对路径，不能填容器内路径。
# =============================================================================


# -----------------------------------------------------------------------------
# 一、宿主机路径
# -----------------------------------------------------------------------------

# 部署根目录（宿主机绝对路径）。
# 仅 systemd 方式需要；Compose 方式会把它固定为镜像内的 /opt/qitos-bench。
WORKSPACE_ROOT=/opt/qitos-bench

# CyberGym 源码根目录，必须包含 src/cybergym/task/README.template。
# 会以相同路径挂进容器；验证服务和跑批都从这里导入 cybergym 包。
CYBERGYM_ROOT=/opt/cybergym

# CyberGym 任务语料目录，跑批从这里读取任务数据。
# 必须在 CYBERGYM_ROOT 下，或同样被挂载到容器内的绝对路径。
DATA_DIR=/opt/cybergym/cybergym_data/data

# agent 源码目录。
# 仅 systemd 方式需要；Compose 方式由镜像固定为 /opt/qitos-bench/cybergym_agent。
AGENT_ROOT=/opt/qitos-bench/cybergym_agent

# QitOS 仓库根目录。
# 仅 systemd 方式需要；Compose 方式由镜像固定为 /opt/qitos-bench/qitos。
QITOS_ROOT=/opt/qitos-bench/qitos

# Python 解释器路径。
# 仅 systemd 方式需要；Compose 方式由镜像固定为 /usr/local/bin/python。
PYTHON_BIN=/usr/local/bin/python

# 预编译漏洞二进制根目录，布局为 <series>/<id>/vul/out/。
# 会以只读方式挂进容器，也是每任务容器 -v 挂载的来源。
BINARY_DIR=/opt/cybergym-bin/cybergym-server-data


# -----------------------------------------------------------------------------
# 二、跑批组
# -----------------------------------------------------------------------------

# 本组的运行根目录。轨迹、workspace、结果文件都写在这里。
# 必须同时是宿主机和容器内的同一个绝对路径；建议放本地 ext4/xfs，不要放网络盘。
RUN_ROOT=/opt/qitos-bench/runs/level1-a

# 任务清单文件，每行一个任务 ID，例如 arvo:3938、oss-fuzz:42535201。
# 文件必须存在且非空；空行会被忽略。
TASK_FILE=/opt/qitos-bench/runs/level1-a/tasks.txt

# 组名，用于默认日志和输出命名；多组部署时保持唯一。
GROUP_NAME=level1-a

# 轨迹文件名前缀，建议带 agent 版本，便于之后筛选，
# 例如 qitos_v17-level1-a_glm-51。
TRACE_PREFIX=qitos_level1-a_glm-51

# 跑批结果 JSONL 文件。--resume 会读取它来跳过已完成任务。
# 必须是宿主机绝对路径，并且位于 RUN_ROOT 下（会被挂载进容器）。
OUTPUT_JSONL=/opt/qitos-bench/runs/level1-a/results.jsonl


# -----------------------------------------------------------------------------
# 三、验证服务（不在本 Compose 项目管理）
# -----------------------------------------------------------------------------

# systemd/本机模式下验证服务绑定的地址。
# Compose 模式忽略这一项（Compose 只使用 SERVER_URL）。
SERVER_HOST=127.0.0.1

# systemd/本机模式下验证服务的端口；同机多组时每组要唯一。
# Compose 模式忽略这一项。
SERVER_PORT=6441

# 跑批提交 PoC 的地址。Compose 模式只看这一项。
#   - 同机：http://host.docker.internal:6441
#     （compose 已加 host-gateway 映射；验证服务必须监听 0.0.0.0）
#   - 异机：http://<server-ip>:6441
# 注意：不要写 127.0.0.1，容器里的 127.0.0.1 指的是容器自己。
SERVER_URL=http://host.docker.internal:6441


# -----------------------------------------------------------------------------
# 四、模型端点
# -----------------------------------------------------------------------------

# OpenAI 兼容接口的 Base URL。
# 必须以 /v1 结尾，客户端不会自动补；少了会报 404。
BASE_URL=https://your-endpoint.example.com/v1

# 模型名称，会原样传给模型端点。
# 例如 GLM-5.1、deepseek-v4.1-flash、mimo-v2.6-flash。
MODEL_NAME=GLM-5.1

# 模型 API key。只用于调用模型，不能和 CYBERGYM_GRADING_KEY 混用。
# 如果 key 里含 $、# 或空格，请用单引号包起来。
LLM_API_KEY=replace-with-model-key


# -----------------------------------------------------------------------------
# 五、打分
# -----------------------------------------------------------------------------

# 验证服务的提交认证 key，必须与 server 端的 CYBERGYM_API_KEY 完全一致。
# 绝不能复用 LLM_API_KEY；两者写反会表现为“认证失败”。
CYBERGYM_GRADING_KEY=replace-with-grading-key


# -----------------------------------------------------------------------------
# 六、调度与预算
# -----------------------------------------------------------------------------

# 并发任务数。真正的瓶颈是内存，不是 CPU：
# 8 GB 建议 1，16 GB 建议 2，32 GB 以上可到 2-4。
CONCURRENCY=2

# 引擎内部步数上限，仅作为防死循环的 guardrail。
# 实际停止主要由 MAX_RUNTIME_SECONDS 控制，通常不需要修改。
MAX_STEPS=1000000

# 单任务墙钟预算，单位秒。14400 = 4 小时；超时会以 budget_time 停止。
MAX_RUNTIME_SECONDS=14400

# CyberGym 难度级别：level0 / level1 / level2 / level3。
# 当前 agent 主要面向 level1。
DIFFICULTY=level1


# -----------------------------------------------------------------------------
# 七、任务容器
# -----------------------------------------------------------------------------

# 每个任务使用的 agent 容器镜像。宿主机上必须已经存在该镜像。
DOCKER_IMAGE=cage/claude-code:cyberdebug

# 任务容器的网络模式。
# host = 与宿主机共享网络（默认，动态分析和抓包场景常用）；
# 也可以填 bridge 或自定义网络名。
DOCKER_NETWORK=host


# -----------------------------------------------------------------------------
# 八、可选
# -----------------------------------------------------------------------------

# 当验证服务用 --mask_map_path 启动时，跑批必须使用同一份掩码表，
# 否则每次 submit_poc 都会失败并返回 Invalid task_id。
# 别名 CYBERGYM_MASK_MAP_PATH 也可用。
# CYBERGYM_MASK_MAP=/opt/cybergym/mask_map.json

# tmux 会话名，仅 --launch（tmux 模式）使用；Compose 和 systemd 都会忽略。
# TMUX_SESSION=jcy-level1-a
